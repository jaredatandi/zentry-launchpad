# Copy to .env at the repository root and fill in before running.
# The .env file is gitignored. Never commit real secrets or bank details.

PORT=3001
DB_PATH=./backend/data/zentry.db

# Long random string used to sign the owner session cookie.
# Leave blank: `npm run setup:admin` generates a strong secret automatically.
# In production the app refuses to start without one.
SESSION_SECRET=

# Owner login. ADMIN_PASSWORD_HASH is a bcrypt hash, NOT a plain password.
# Generate it with: npm run setup:admin
ADMIN_EMAIL=jaredkeago07@gmail.com
ADMIN_PASSWORD_HASH=

# Set to true only when serving over HTTPS (e.g. through a Cloudflare Tunnel).
COOKIE_SECURE=false

# Only set when a trusted reverse proxy is in front of the app (hop count, e.g. 1).
# Leave blank for direct exposure so X-Forwarded-For cannot spoof rate-limit keys.
TRUST_PROXY=

# Frontend only: leave empty for local dev (Vite proxies /api to the backend).
# For GitHub Pages, set this to your public backend/tunnel URL.
VITE_API_BASE_URL=
